{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5432;Database=partyup;Username=partyup;Password=partyup"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "TokenRetention": "30.00:00:00"
  },
  "Admin": {
    "SeedUserIds": [],
    "SeedEmails": []
  },
  "Deletion": {
    "SweepEnabled": true,
    "SweepInterval": "00:15:00",
    "SweepBatchSize": 50,
    "JournalPath": "/data/deletion-journal"
  },
  "PublicBaseUrl": "http://localhost:5173",
  "Email": {
    "Provider": "log",
    "FromAddress": "no-reply@mail.partyup.social",
    "FromName": "PartyUp",
    "DropPath": "mail-drop",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": ""
    }
  },
  "Push": {
    "Provider": "log",
    "DropPath": "push-drop",
    "Vapid": {
      "PublicKey": "",
      "PrivateKey": "",
      "Subject": ""
    }
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Steam": {
    "Enabled": true,
    "ApiKey": "",
    "Realm": ""
  },
  "Security": {
    "PartitionPepper": ""
  },
  "Network": {
    "TrustedProxies": []
  },
  "AllowedHosts": "*"
}
