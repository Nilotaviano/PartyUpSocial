<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PartyUp.Infrastructure\PartyUp.Infrastructure.csproj" />
    <ProjectReference Include="..\PartyUp.Application\PartyUp.Application.csproj" />
    <ProjectReference Include="..\PartyUp.Domain\PartyUp.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="SixLabors.Fonts" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>

  <!-- D-224: the aspnet:10.0 runtime image ships no system fonts, so the card renderer loads this
       bundled OFL face from the output directory rather than looking one up on the host. -->
  <ItemGroup>
    <None Include="Assets\Fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
