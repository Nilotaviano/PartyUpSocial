<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- A-082: explicitly-defaulted opt-in, not an OS condition. An undefined MSBuild property
         expands to the empty string, which is not `false`, so the default clause below only fires
         when nothing set the property — every `dotnet test` on every OS (Windows dev host, WSL full
         suite, CI's solution-wide `dotnet` job) discovers zero tests here unless the caller passes
         `-p:PartyUpBrowserTests=true` (CLAUDE.md's canonical local command; CI's dedicated `browser`
         job, `.github/workflows/ci.yml`). This must stay textually before `IsTestProject` below. -->
    <PartyUpBrowserTests Condition="'$(PartyUpBrowserTests)' == ''">false</PartyUpBrowserTests>
    <IsTestProject>$(PartyUpBrowserTests)</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runner reads this from the test assembly's own output directory, so it has to be
         copied there: the four collections in PlaywrightFixture.cs only overlap because it turns
         collection parallelism on. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only: the browser lane's own real-clock backdoor (PlaywrightFixture.BackdatePollPastDeadlineAsync)
         needs a Postgres client to write the same DB the running API reads. This never wires any
         Infrastructure DI, EF DbContext, or app service — it only reuses the `Npgsql` assembly this
         project reference already carries transitively, avoiding a second, uncentralized package
         version. -->
    <ProjectReference Include="..\..\src\PartyUp.Infrastructure\PartyUp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
