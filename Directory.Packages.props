<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.12.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.24" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageVersion Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="NodaTime" Version="3.3.3" />
    <PackageVersion Include="NodaTime.Testing" Version="3.3.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="10.0.3" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- D-224: text layout for the server-rendered invite-unfurl card. -->
    <PackageVersion Include="SixLabors.Fonts" Version="2.1.3" />
    <!-- A-084: capture-time re-encoding of avatar pictures to WebP (AVATARS_DESIGN.md §3.2). -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.1" />
    <!-- D-224: shape and text drawing for the invite-unfurl card; the 2.1.x line is the one built
         against ImageSharp 3.1.x. -->
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- Transitive pins (nothing references these directly). -->
  <ItemGroup>
    <!-- Microsoft.AspNetCore.OpenApi 10.0.10 resolves Microsoft.OpenApi 2.0.0, which
         GHSA-v5pm-xwqc-g5wc rates high severity; 2.7.5 is the first patched 2.x. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Npgsql asks for EF Relational 10.0.4 while EF Design asks for 10.0.10; without a pin the
         assembly versions differ across projects (MSB3277). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <!-- Hangfire.Core asks for Newtonsoft.Json >= 11.0.1, which GHSA-5crp-9r3c-p9vr rates high
         severity; 13.0.3 is the first version NU1903 accepts. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Testcontainers.PostgreSql 4.13.0 resolves SSH.NET 2025.1.0, which carries a high-severity
         advisory NU1903 rejects; 2026.0.0 is the current patched release. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
