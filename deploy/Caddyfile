partyup.social {
	encode zstd gzip

	reverse_proxy app:8080

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The query filter's wildcard-looking form reads the asterisk
				# as a literal parameter name and scrubs nothing; this regexp
				# is the form proven to strip the whole query string against
				# the pinned caddy:2 image.
				request>uri multi_regexp {
					regexp "\?.*" ""
					regexp "(?i)^(/(u|add|g|a|api/v1/(users/by-username|friend-codes))/).*" "${1}REDACTED"
				}
				resp_headers>Location multi_regexp {
					regexp "\?.*" ""
					regexp "(?i)^(https?://[^/]+)?(/(u|add|g|a|api/v1/(users/by-username|friend-codes))/).*" "${1}${2}REDACTED"
				}
				# PHASE4_DESIGN.md §9.2: the guest bearer token never appears in a log even via the
				# Referer header a browser navigation from /g/<token> could otherwise carry.
				request>headers>Referer delete
			}
		}
	}

	# OWNER-ACTION P3-DEPLOY-01: copy, validate, reload, and marker-test this
	# bind-mounted file on the VM before exposing the identifier-bearing routes.

	# Phase 4 guest links (bearer-token URLs, ARCHITECTURE.md §10) are scrubbed from access logs by
	# the request>uri filter above, e.g.:
	#
	# log {
	# 	output stdout
	# 	format filter {
	# 		wrap json
	# 		fields {
	# 			request>uri regexp "(/g/)[^/?]+" "${1}REDACTED"
	# 		}
	# 	}
	# }
}
