partyup.social {
	encode zstd gzip

	reverse_proxy app:8080

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The query filter's wildcard-looking form reads the asterisk
				# as a literal parameter name and scrubs nothing; this regexp
				# is the form proven to strip the whole query string against
				# the pinned caddy:2 image.
				request>uri regexp "\?.*" ""
			}
		}
	}

	# Phase 4 adds guest links (bearer-token URLs, ARCHITECTURE.md §10). Once those
	# routes exist, scrub the token from access logs with a uri regexp filter, e.g.:
	#
	# log {
	# 	output stdout
	# 	format filter {
	# 		wrap json
	# 		fields {
	# 			request>uri regexp "(guest/)[^/?]+" "${1}REDACTED"
	# 		}
	# 	}
	# }
}
