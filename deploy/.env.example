# Copy to deploy/.env on the VM and fill in real values. Never commit the real .env
# (repo .gitignore already excludes it).
POSTGRES_USER=partyup
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=partyup

# Steam Web API key (persona/avatar enrichment; sign-in works without it).
# Optional — compose substitutes empty when unset.
STEAM_API_KEY=

# Admin seeding (A-039). Set to the owner account's UserId (read it from the DB or the
# admin user list after registering). Admin endpoints answer 404 for everyone until set.
ADMIN_SEED_USER_ID=

# Transactional mail. Leave EMAIL_PROVIDER unset (defaults to log — dev-only, mails are
# dropped in production) until the SMTP values are filled, then set it to smtp.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend,
# SMTP_PASSWORD=<Resend API key>. Sender domain mail.partyup.social must have the
# SPF/DKIM/DMARC records from the Resend dashboard before real sends.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google OAuth (sign-in button appears automatically once ClientId is non-empty, A-042).
# Web application credentials from Google Cloud Console; authorized redirect URI:
# https://partyup.social/api/v1/auth/external/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# compose.yaml composes these three into the app service's ConnectionStrings__Db
# via variable substitution; the line below is not read by anything, it's here to show
# the derivation:
# ConnectionStrings__Db=Host=postgres;Port=5432;Database=partyup;Username=partyup;Password=CHANGEME
