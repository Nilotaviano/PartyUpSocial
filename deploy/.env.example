# Copy to deploy/.env on the VM and fill in real values. Never commit the real .env
# (repo .gitignore already excludes it).
POSTGRES_USER=partyup
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=partyup

# Steam Web API key (persona/avatar enrichment; sign-in works without it).
# Optional — compose substitutes empty when unset.
STEAM_API_KEY=

# compose.yaml composes these three into the app service's ConnectionStrings__Db
# via variable substitution; the line below is not read by anything, it's here to show
# the derivation:
# ConnectionStrings__Db=Host=postgres;Port=5432;Database=partyup;Username=partyup;Password=CHANGEME
